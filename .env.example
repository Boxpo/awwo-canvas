# AwwO Canvas reads plain environment variables; nothing loads this file automatically.
# Copy the lines you need into your shell (or your process manager). Never commit real keys.

# --- orchestrator (apps/server) ---
AWWO_HOST=127.0.0.1                 # a non-loopback bind is refused unless AWWO_API_TOKEN is set
AWWO_PORT=8787
AWWO_API_TOKEN=                     # bearer token for /api (required off-loopback)
AWWO_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AWWO_RUNTIMES_FILE=runtimes.json    # hot-plug registry, watched for edits
AWWO_SKILLS_DIR=skills              # orchestration skills, hot-reloaded
AWWO_WEB_DIST=apps/web/dist         # built canvas served on the orchestrator port when present
AWWO_DEFAULT_RUNTIME=               # '' = runtimes.json defaultRuntime, then first ready
AWWO_PLANNER_RUNTIME=
AWWO_PLANNER_MODEL=
AWWO_ROUTER_RUNTIME=
AWWO_ROUTER_MODEL=
AWWO_PROBE_INTERVAL_MS=10000

# --- mock worker (workers/mock) ---
AWWO_WORKER_PORT=8791
AWWO_WORKER_RUNTIME=mock
AWWO_WORKER_TOKEN=
AWWO_REGISTER_URL=                  # e.g. http://127.0.0.1:8787 to self-register (hot-plug)

# --- OpenAI-compatible worker (workers/openai-compatible) ---
AWWO_OPENAI_BASE_URL=https://api.openai.com/v1
AWWO_OPENAI_API_KEY=                # falls back to OPENAI_API_KEY
AWWO_OPENAI_MODELS=                 # comma list; empty = discover from GET /models
AWWO_OPENAI_MODEL=                  # default model; empty = first of the list
AWWO_OPENAI_EFFORTS=                # e.g. low,medium,high for reasoning models
AWWO_OPENAI_THINKING_TOGGLE=        # 1 = relay accepts {"thinking":{"type":"disabled"}}
AWWO_OPENAI_WORKER_PORT=8792
AWWO_OPENAI_WORKER_TOKEN=           # orchestrator -> worker bearer (runtimes.json tokenEnv)

# --- Python worker (workers/python-minimal) ---
AWWO_PY_WORKER_PORT=8793
